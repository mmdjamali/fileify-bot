BOT_TOKEN=

# comma-separated channels users must join, e.g. @mmdhere
CHANNELS=@mmdhere
# comma-separated Telegram user ids allowed to use /stats
ADMIN_IDS=

REDIS_URL=redis://localhost:6379

DOWNLOAD_DIR=./downloads
PROCESSED_DIR=./processed

MAX_FILE_SIZE_MB=20
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=300

# local Bot API server (docker compose --profile local-api), get the id/hash from my.telegram.org
# BOT_API_ROOT=http://telegram-bot-api:8081
# MAX_FILE_SIZE_MB=2000
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
