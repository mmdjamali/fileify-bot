start = سلام! فایلی داری که بخوای ویرایشش کنی؟

join-channels = برای ادامه باید به کانال‌های زیر بپیوندید.
check-join = عضو شدم ✅
not-joined-yet = هنوز عضو همهٔ کانال‌ها نشدی.

video = می‌خواهید با این ویدیو چه کاری انجام دهید؟ 🤔
video-note = 📹 ویدیو نوت
video-too-long = ویدیو باید کمتر از ۶۰ ثانیه باشد
video-to-gif = 🎞 تبدیل به گیف
gif-too-long = برای تبدیل به گیف، ویدیو باید کمتر از { $seconds } ثانیه باشد

audio = می‌خواهید با این فایل صوتی چه کاری انجام دهید؟ 🤔
audio-metadata = ✏️ ویرایش اطلاعات متادیتا
audio-new-title = عنوان جدید چی باشه؟
audio-new-artist = اسم هنرمند جدید چیه؟
audio-new-album = اسم آلبوم جدید چیه؟
audio-new-cover = عکس جدید برای آهنگ چی باشه؟
audio-cover-invalid = لطفاً یک عکس JPEG یا PNG بفرستید، یا «رد کردن» رو بزنید.

photo = می‌خواید با این عکس چه کاری انجام بدید؟ 🤔
photo-resize = 📐 تغییر اندازهٔ تصویر
photo-resize-prompt =
    📐 اندازهٔ فعلی: { $width }x{ $height }

    می‌خواید عکس رو به چه ابعادی تغییر بدید؟
    لطفاً مقدار رو به صورت WIDTHxHEIGHT (مثلاً 512x512) ارسال کنید
photo-resize-invalid = فرمت نامعتبره، لطفاً دوباره امتحان کنید.
photo-resize-too-large = ابعاد خیلی بزرگه. عرض و ارتفاع باید حداکثر { $max } پیکسل باشه.


downloading = ⬇️ در حال دانلود...
processing = 🔄 در حال پردازش...
uploading = ⬆️ در حال آپلود به تلگرام...
queued = ⏳ در صف انتظار (نفر { $position })...

cancel = ❌ لغو
canceled = ❌ لغو شد!
skip = ⏩ رد کردن

error = مشکلی پیش آمد! دوباره امتحان کنید!
unsupported-file = این نوع فایل پشتیبانی نمی‌شه. لطفاً عکس، ویدیو، گیف یا فایل صوتی بفرستید.

file-size-error = حجم فایل باید کمتر از { $size } مگابایت باشد